{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "Maintain semantic decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "workspace_id",
    "event_id",
    "summary",
    "changed_paths",
    "writes",
    "question",
    "evidence_paths",
    "resolved_report_ids"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "no_change",
        "updated_quiet",
        "updated_report",
        "needs_decision",
        "freshness_failed"
      ]
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "expected_sha256", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "expected_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {"type": "string"}
        }
      }
    },
    "question": {
      "type": ["string", "null"]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resolved_report_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "uniqueItems": true
    }
  }
}
